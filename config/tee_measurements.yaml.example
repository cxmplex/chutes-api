# Canonical TEE measurement configuration.
#
# Every list item is one exact hardware/provider/role pin. The loader rejects unknown fields and
# does not accept the former nested `hardware` or `boot_rtmrs`/`runtime_rtmrs` formats.
# `debug` and `gpu_count` are mandatory. `rc: true` remains attestable but is excluded from the
# public measurement endpoint and minimum-version fallback.
#
# Managed release pins also carry `image_sha256` and the complete ordered
# `image_measurement_names` set. Production activation verifies detached cosign provenance.
measurements:
  # Intel TDX: RTMR0-2 are common to boot/runtime. Boot RTMR3 is always derived as 96 zeroes;
  # runtime_rtmr3 is the measured guest/root identity.
  - version: "1.3.0"
    name: "8xh200"
    description: "8x H200 GPU TDX configuration"
    tee_type: "tdx"
    debug: false
    rc: false
    mrtd: "REPLACE_WITH_MRTD_96_HEX"
    rtmr0: "REPLACE_WITH_RTMR0_96_HEX"
    rtmr1: "REPLACE_WITH_RTMR1_96_HEX"
    rtmr2: "REPLACE_WITH_RTMR2_96_HEX"
    runtime_rtmr3: "REPLACE_WITH_RUNTIME_RTMR3_96_HEX"
    expected_gpus:
      - "h200"
    gpu_count: 8

  - version: "1.3.0"
    name: "cpu-gcp-tdx-1.3.0"
    description: "CPU-only GCP TDX configuration"
    provider: "gcp"
    tee_type: "tdx"
    debug: false
    rc: false
    mrtd: "REPLACE_WITH_CPU_MRTD_96_HEX"
    rtmr0: "REPLACE_WITH_CPU_RTMR0_96_HEX"
    rtmr1: "REPLACE_WITH_CPU_RTMR1_96_HEX"
    rtmr2: "REPLACE_WITH_CPU_RTMR2_96_HEX"
    runtime_rtmr3: "REPLACE_WITH_CPU_RUNTIME_RTMR3_96_HEX"
    expected_gpus: []
    gpu_count: 0

  # AMD SEV-SNP: bare-metal image identity is folded into the launch measurement. GCP SNP must
  # additionally pin real PCR8/PCR9 and the four signed Google AK extension flags.
  - version: "1.3.0-snp-4vcpu"
    name: "cpu-baremetal-snp-genoa-1.3.0-4vcpu"
    description: "CPU-only bare-metal AMD SEV-SNP configuration"
    provider: "bare-metal"
    tee_type: "sev-snp"
    processor_model: "Genoa"
    debug: false
    rc: false
    measurement: "REPLACE_WITH_SNP_LAUNCH_MEASUREMENT_96_HEX"
    policy: "0x30000"
    min_tcb:
      bootloader: 7
      tee: 0
      snp: 23
      microcode: 72
    expected_vmpl: 0
    expected_gpus: []
    gpu_count: 0

  - version: "1.3.0-snp-gcp"
    name: "cpu-gcp-snp-milan-1.3.0"
    description: "CPU-only GCP AMD SEV-SNP configuration"
    provider: "gcp"
    tee_type: "sev-snp"
    processor_model: "Milan"
    debug: false
    rc: true
    measurement: "REPLACE_WITH_GCP_SNP_FIRMWARE_MEASUREMENT_96_HEX"
    policy: "0x30000"
    min_tcb:
      bootloader: 4
      tee: 0
      snp: 29
      microcode: 222
    expected_vmpl: 0
    vtpm_pcrs:
      "8": "REPLACE_WITH_REAL_PCR8_SHA256_64_HEX"
      "9": "REPLACE_WITH_REAL_PCR9_SHA256_64_HEX"
    vtpm_security_flags:
      "2": true
      "3": false
      "4": false
      "5": false
    expected_gpus: []
    gpu_count: 0

revoked_measurements: []
