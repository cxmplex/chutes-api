# Strict nested TEE measurement configuration.
#
# The document root contains exactly `measurements` and `revoked_measurements`. Each measurement
# item is a group: image/TEE fields shared by every variant stay at group level, while the required
# non-empty `hardware` list contains each exact variant name, optional description, CPU/GPU
# inventory, and exactly one variant measurement (`rtmr0` for TDX, `measurement` for SEV-SNP).
# Flat scalar entries and boot_rtmrs/runtime_rtmrs maps are not accepted.
#
# `debug` is mandatory. `rc: true` remains attestable but is omitted from the public measurement
# endpoint and minimum-version fallback. Managed release groups additionally carry `image_sha256`
# and the complete ordered `image_measurement_names` list together; production activation verifies
# detached cosign provenance. Replace placeholders only with observed, build-derived values.
measurements:
  # Intel TDX: MRTD, RTMR1/2, boot RTMR3, and runtime RTMR3 are shared. Only RTMR0 varies by
  # hardware topology. boot_rtmr3 is optional and otherwise defaults to 96 zeroes.
  - version: "1.3.0"
    tee_type: "tdx"
    debug: false
    rc: false
    mrtd: "REPLACE_WITH_MRTD_96_HEX"
    rtmr1: "REPLACE_WITH_RTMR1_96_HEX"
    rtmr2: "REPLACE_WITH_RTMR2_96_HEX"
    runtime_rtmr3: "REPLACE_WITH_RUNTIME_RTMR3_96_HEX"
    hardware:
      - name: "8xh200"
        description: "8x H200 GPU TDX configuration"
        rtmr0: "REPLACE_WITH_RTMR0_96_HEX"
        expected_gpus:
          - "h200"
        gpu_count: 8

  - version: "1.3.0"
    tee_type: "tdx"
    provider: "gcp"
    debug: false
    rc: false
    mrtd: "REPLACE_WITH_CPU_MRTD_96_HEX"
    rtmr1: "REPLACE_WITH_CPU_RTMR1_96_HEX"
    rtmr2: "REPLACE_WITH_CPU_RTMR2_96_HEX"
    # boot_rtmr3: "REPLACE_IF_BOOT_RTMR3_IS_NOT_ZERO"
    runtime_rtmr3: "REPLACE_WITH_CPU_RUNTIME_RTMR3_96_HEX"
    hardware:
      - name: "cpu-gcp-tdx-1.3.0"
        description: "CPU-only GCP TDX configuration"
        rtmr0: "REPLACE_WITH_CPU_RTMR0_96_HEX"
        expected_gpus: []
        gpu_count: 0

  # AMD SEV-SNP: policy, minimum TCB, processor model, VMPL, and optional id-key digest are shared.
  # Bare-metal image identity is folded into each per-variant launch measurement.
  - version: "1.3.0-snp-4vcpu"
    tee_type: "sev-snp"
    provider: "bare-metal"
    processor_model: "Genoa"
    debug: false
    rc: false
    policy: "0x30000"
    min_tcb:
      bootloader: 7
      tee: 0
      snp: 23
      microcode: 72
    expected_vmpl: 0
    hardware:
      - name: "cpu-baremetal-snp-genoa-1.3.0-4vcpu"
        description: "CPU-only bare-metal AMD SEV-SNP configuration"
        measurement: "REPLACE_WITH_SNP_LAUNCH_MEASUREMENT_96_HEX"
        expected_gpus: []
        gpu_count: 0

  # GCP SNP additionally requires exactly PCR8/PCR9 and signed-AK boolean tags 2/3/4/5.
  - version: "1.3.0-snp-gcp"
    tee_type: "sev-snp"
    provider: "gcp"
    processor_model: "Milan"
    debug: false
    rc: true
    policy: "0x30000"
    min_tcb:
      bootloader: 4
      tee: 0
      snp: 29
      microcode: 222
    expected_vmpl: 0
    vtpm_pcrs:
      "8": "REPLACE_WITH_REAL_PCR8_SHA256_64_HEX"
      "9": "REPLACE_WITH_REAL_PCR9_SHA256_64_HEX"
    vtpm_security_flags:
      "2": true
      "3": false
      "4": false
      "5": false
    hardware:
      - name: "cpu-gcp-snp-milan-1.3.0"
        description: "CPU-only GCP AMD SEV-SNP configuration"
        measurement: "REPLACE_WITH_GCP_SNP_FIRMWARE_MEASUREMENT_96_HEX"
        expected_gpus: []
        gpu_count: 0

revoked_measurements: []
