      rtmr2: "D1E2F30415263748D9EAFB0C1D2E3F40D1E2F30415263748D9EAFB0C1D2E3F40D1E2F30415263748D9EAFB0C1D2E3F40"
      rtmr3: "E1F20314253647580E1F2D3C4B5A6978E1F20314253647580E1F2D3C4B5A6978E1F20314253647580E1F2D3C4B5A6978"
    runtime_rtmrs:
      rtmr0: "B1C2D3E4F5061728B9CADBECFD0E1F20B1C2D3E4F5061728B9CADBECFD0E1F20B1C2D3E4F5061728B9CADBECFD0E1F20"
      rtmr1: "C1D2E3F405162738C9DAEBFC0D1E2F30C1D2E3F405162738C9DAEBFC0D1E2F30C1D2E3F405162738C9DAEBFC0D1E2F30"
      rtmr2: "F1A2B3C4D5E6071829FAEBDC0D1E2F30F1A2B3C4D5E6071829FAEBDC0D1E2F30F1A2B3C4D5E6071829FAEBDC0D1E2F30"
      rtmr3: "0A1B2C3D4E5F60718293A4B5C6D7E8F00A1B2C3D4E5F60718293A4B5C6D7E8F00A1B2C3D4E5F60718293A4B5C6D7E8F0"
    expected_gpus: []
    gpu_count: 0
